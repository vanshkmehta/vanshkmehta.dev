---
import { getCollection } from "astro:content";
import ImpactReceipt from "../components/ImpactReceipt.astro";
import NoteCard from "../components/NoteCard.astro";
import { PROFILE } from "../data/profile";
import { PATHS, SITE } from "../data/site";
import { formatDate } from "../lib/utils";
import PageLayout from "../layouts/PageLayout.astro";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestNotes = notes.slice(0, 3);
const topics = "JAVA · SPRING BOOT · DISTRIBUTED SYSTEMS · RABBITMQ · POSTGRES · REDIS · KUBERNETES · AI INFRASTRUCTURE · ";
---

<PageLayout>
  <section class="relative overflow-hidden">
    <div class="wrap relative min-w-0 pt-12 md:pt-16">
      <div class="sticker absolute right-5 top-8 z-10 md:right-8 md:top-12" aria-hidden="true">
        backend engineer at jio, mumbai
      </div>
      <h1 class="poster-word" aria-label="Vansh Mehta">
        <span>Vansh</span>
        <span class="outline">Mehta</span>
      </h1>
      <div class="mt-8 grid min-w-0 items-end gap-8 md:grid-cols-2 md:gap-12">
        <div class="min-w-0">
          <p class="max-w-[20ch] font-serif text-[clamp(1.7rem,1.1rem+2.2vw,2.5rem)] italic leading-[1.1]">
            Backend engineer. I build it, break it, explain it.
          </p>
          <p class="mt-4 max-w-[36ch] text-[1.02rem] leading-relaxed text-muted">
            At Jio I build the cloud systems that 100K+ enterprise users depend on. On YouTube I show how things like that work.
          </p>
          <p class="mt-6 flex flex-wrap gap-2">
            <a class="btn-primary" href={SITE.youtube} target="_blank" rel="noopener noreferrer">Watch on YouTube</a>
            <a class="btn-ghost" href="#contact">Say hello</a>
          </p>
        </div>
        <ul class="index-list">
          <li><a href="#impact">What I built at Jio <span aria-hidden="true">→</span></a></li>
          <li><a href="#builds">My own builds <span aria-hidden="true">→</span></a></li>
          <li><a href={PATHS.course}>The video seasons <span aria-hidden="true">→</span></a></li>
          <li><a href={PATHS.about}>About me <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </div>
    <div class="ticker mt-10" aria-hidden="true"><div>{topics.repeat(6)}</div></div>
  </section>

  <div class="wrap flex flex-col gap-20 py-16 md:gap-28 md:py-24">
    <section class="min-w-0" aria-labelledby="hi">
      <div class="flex min-w-0 items-center gap-5">
        <img src="/vansh.webp" width="96" height="96" alt="Vansh Mehta" class="size-20 shrink-0 rounded-full border-2 border-ink object-cover md:size-24" loading="eager" />
        <h2 id="hi" class="display">Hi, I'm Vansh.</h2>
      </div>
      <div class="mt-5 max-w-[42rem] space-y-4 text-[1.02rem] leading-relaxed text-muted">
        <p>
          I'm a backend engineer at Jio in Mumbai. Most of my day goes into making sure a cloud order doesn't fail halfway through, whether that means checking quotas up front, keeping queues moving or finding out why something broke at 2 a.m.
        </p>
        <p>
          Outside work I build my own products and make videos about how software works underneath. I learn by building something and breaking it, so that is how I teach too.
        </p>
      </div>
      <dl class="mt-10 grid min-w-0 grid-cols-2 gap-x-6 gap-y-8 border-t-2 border-ink pt-8 lg:grid-cols-4">
        {
          PROFILE.proof.map((p) => (
            <div class="min-w-0">
              <dt class="font-display text-[clamp(2.6rem,1.8rem+3.4vw,4.5rem)] font-black uppercase leading-[0.9]">{p.value}</dt>
              <dd class="mt-2 text-sm leading-snug text-muted">{p.label}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="impact" class="grid min-w-0 scroll-mt-24 items-center gap-10 md:grid-cols-[minmax(0,1fr)_21.5rem] md:gap-16">
      <div class="min-w-0">
        <h2 class="display">What I built at Jio</h2>
        <p class="lede mt-5">
          Seven pieces of Jio's cloud platform that I designed or built, with what changed after each one.
        </p>
        <ul class="mt-6 max-w-[40rem] space-y-3 text-[1.02rem] leading-relaxed text-muted">
          <li><span class="text-ink">Quota validation.</span> Bad orders get caught at the door, across VMs, block storage, security groups and HSM, instead of failing halfway through provisioning. Failed orders dropped 40%.</li>
          <li><span class="text-ink">Async order pipeline.</span> RabbitMQ keeps compute, storage and network provisioning from blocking each other.</li>
          <li><span class="text-ink">Ops diagnostics.</span> A way to trace a provisioning failure end to end. Closing a production incident now takes 60% less time.</li>
        </ul>
        <p class="mt-6"><a class="btn-ghost" href={PATHS.about}>The longer version</a></p>
      </div>
      <div class="min-w-0 md:justify-self-end">
        <div class="rotate-[1.2deg]"><ImpactReceipt /></div>
      </div>
    </section>

    <section class="grid min-w-0 items-center gap-8 md:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] md:gap-14" aria-labelledby="recognition">
      <figure class="min-w-0 md:-rotate-1">
        <img
          src={PROFILE.awards[0].image800}
          srcset={`${PROFILE.awards[0].image800} 800w, ${PROFILE.awards[0].image} 1600w`}
          sizes="(min-width: 768px) 50vw, 100vw"
          width="800"
          height="582"
          loading="lazy"
          alt="Jio CloudXP certificate: Star Performer, Best Debutant, awarded to Vanshit Mehta for Resource-Based Quota Management."
          class="w-full border-2 border-ink"
        />
      </figure>
      <div class="min-w-0">
        <p class="caption text-accent">Recognition</p>
        <h2 id="recognition" class="display mt-3">Star Performer, Best Debutant</h2>
        <p class="mt-4 text-[1.02rem] leading-relaxed text-muted">
          Jio CloudXP gave me this for owning Resource-Based Quota Management end to end: the technical depth, and getting it delivered reliably.        </p>
        <p class="mt-6 border-t border-line pt-5 text-[1.02rem] leading-relaxed text-muted">
          <span class="text-ink">Before that:</span> a Gold Medal and 3rd Prize at Anveshana 2023 for Kavach, a women's safety app I built as a student. It was also shortlisted for the Government of India Tech Innovation Awards.
        </p>
      </div>
    </section>

    <section id="builds" class="min-w-0 scroll-mt-24">
      <h2 class="display">What I'm building</h2>
      <div class="mt-8 grid min-w-0 gap-4 md:grid-cols-3">
        {
          PROFILE.builds.map((b) => (
            <article class="card min-w-0 p-6">
              <p class="caption text-accent">{b.year}</p>
              <h3 class="title mt-3">{b.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{b.text}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-4"><a class="caption text-accent hover:underline" href={PATHS.build}>More builds →</a></p>
    </section>

    <section class="min-w-0" aria-labelledby="yt">
      <h2 id="yt" class="display max-w-2xl">I make videos about how it all works.</h2>
      <p class="lede mt-5">
        Databases, low-level design, system design and distributed systems, each one built from scratch on camera. Short clips most days, a longer video each week.
      </p>
      <p class="mt-6 flex flex-wrap gap-2">
        <a class="btn-primary" href={SITE.youtube} target="_blank" rel="noopener noreferrer">Watch on YouTube</a>
        <a class="btn-ghost" href={PATHS.course}>See what's coming</a>
      </p>
      {
        latestNotes.length > 0 && (
          <div class="mt-10 grid min-w-0 gap-4 md:grid-cols-3">
            {latestNotes.map((note) => (
              <NoteCard
                href={`/notes/${note.id}`}
                kicker={note.data.seasonTitle}
                title={note.data.topic}
                description={note.data.description}
                meta={formatDate(note.data.pubDate)}
              />
            ))}
          </div>
        )
      }
    </section>

    <section id="contact" class="min-w-0 scroll-mt-24" aria-labelledby="hello">
      <h2 id="hello" class="display max-w-2xl">Say hello.</h2>
      <p class="lede mt-5">Working on something interesting, or just curious? I read everything. Email is fastest.</p>
      <p class="mt-6 flex flex-wrap items-center gap-3">
        <a class="btn-primary" href={`mailto:${SITE.email}`}>Email me</a>
        <a class="btn-ghost" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn-ghost" href={SITE.x} target="_blank" rel="noopener noreferrer">X</a>
        <a class="btn-ghost" href="/resume.pdf">Resume (PDF)</a>
      </p>
      <p class="mt-4 select-all font-mono text-xs text-muted">{SITE.email}</p>
    </section>
  </div>
</PageLayout>
