---
import { getCollection } from "astro:content";
import NoteCard from "../../components/NoteCard.astro";
import { formatDate } from "../../lib/utils";
import PageLayout from "../../layouts/PageLayout.astro";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<PageLayout
  title="Notes"
  description="Short written notes that go with my videos: the idea, a diagram, and the part that tripped me up."
>
  <section class="wrap page-head">
    <h1 class="display">Notes</h1>
    <p class="lede mt-6">
      {
        notes.length === 0
          ? "Written notes that go with my videos will show up here. The first ones arrive with the first season."
          : "Short notes that go with my videos: the idea, a diagram, and the part that tripped me up."
      }
    </p>
  </section>

  <section class="wrap pb-16 md:pb-24">
    {
      notes.length > 0 && (
        <div class="grid min-w-0 gap-4 md:grid-cols-2 lg:grid-cols-3">
          {notes.map((note) => (
            <NoteCard
              href={`/notes/${note.id}`}
              kicker={note.data.seasonTitle}
              title={note.data.topic}
              description={note.data.description}
              meta={formatDate(note.data.pubDate)}
            />
          ))}
        </div>
      )
    }
  </section>
</PageLayout>
