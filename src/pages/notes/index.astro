---
import { getCollection } from "astro:content";
import NoteCard from "../../components/NoteCard.astro";
import { seasons } from "../../data/seasons";
import { formatDate } from "../../lib/utils";
import PageLayout from "../../layouts/PageLayout.astro";

const notes = await getCollection("notes");
const bySeason = seasons
  .map((season) => ({
    season,
    notes: notes
      .filter((n) => n.data.season === season.id)
      .sort((a, b) => a.data.topic.localeCompare(b.data.topic)),
  }))
  .filter((group) => group.notes.length > 0);
---

<PageLayout
  title="Notes"
  description="Study notes for the CS course. One post per topic: whiteboard, questions, build."
>
  <section class="wrap page-head">
    <p class="section-kicker">Study guides</p>
    <h1 class="display mt-5">Notes</h1>
    <div class="rule-cyan mt-5"></div>
    <p class="lede mt-6">
      {
        notes.length === 0
          ? "Study sheets for the course. Nothing published yet."
          : "One note per topic: whiteboard, interview problems, then the build."
      }
    </p>
  </section>

  <section class="wrap pb-16 md:pb-20">
    {
      bySeason.length === 0 ? (
        <div class="card max-w-[40rem] px-6 py-12">
          <p class="title text-ink">Notes coming soon.</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            I will publish study sheets here as Season 1 ships. For now, the class is on YouTube.
          </p>
        </div>
      ) : (
        <div class="space-y-16">
          {bySeason.map(({ season, notes: seasonNotes }) => (
            <section class="min-w-0">
              <div class="flex min-w-0 flex-wrap items-end justify-between gap-3 border-b border-line pb-3">
                <h2 class="title min-w-0">
                  <span class="font-mono text-sm text-accent">{season.code}</span>
                  <span class="ml-3">{season.title}</span>
                </h2>
                <a class="caption shrink-0 text-muted hover:text-accent" href={`/course/${season.slug}`}>
                  Season page
                </a>
              </div>
              <div class="mt-6 grid min-w-0 gap-4 md:grid-cols-2">
                {seasonNotes.map((note) => (
                  <NoteCard
                    href={`/notes/${note.id}`}
                    kicker={note.data.episodeIds.join(" · ")}
                    title={note.data.topic}
                    description={note.data.description}
                    meta={formatDate(note.data.pubDate)}
                    showModes
                  />
                ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </section>
</PageLayout>
