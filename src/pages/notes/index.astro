---
import { getCollection } from "astro:content";
import NoteCard from "../../components/NoteCard.astro";
import { seasons } from "../../data/seasons";
import { formatDate } from "../../lib/utils";
import PageLayout from "../../layouts/PageLayout.astro";

const notes = await getCollection("notes");
const bySeason = seasons
  .map((season) => ({
    season,
    notes: notes
      .filter((n) => n.data.season === season.id)
      .sort((a, b) => a.data.topic.localeCompare(b.data.topic)),
  }))
  .filter((group) => group.season.status === "filming" || group.notes.length > 0);
---

<PageLayout
  title="Notes"
  description="Topic-level study guides for the CS curriculum. One post per topic: whiteboard, questions, build."
>
  <section class="wrap py-16 sm:py-20">
    <p class="section-kicker">Study guides</p>
    <h1 class="mt-5 text-3xl font-medium tracking-tight sm:text-4xl">Notes</h1>
    <div class="rule-cyan mt-5"></div>
    <p class="mt-6 max-w-[46rem] leading-relaxed text-muted">
      One note per topic — not per video. Each post stitches the trilogy: board, interview problems, then the build. Drop a Markdown file in <code class="font-mono text-sm text-accent">src/content/notes</code> to add another.
    </p>

    <div class="mt-14 space-y-16">
      {
        bySeason.map(({ season, notes: seasonNotes }) => (
          <section>
            <div class="flex flex-wrap items-end justify-between gap-3 border-b border-line pb-3">
              <h2 class="text-xl font-medium tracking-tight">
                <span class="font-mono text-sm text-accent">{season.code}</span>
                <span class="ml-3">{season.title}</span>
              </h2>
              <a class="font-mono text-[11px] text-muted hover:text-accent" href={`/course/${season.slug}`}>
                Season page
              </a>
            </div>

            {seasonNotes.length > 0 ? (
              <div class="mt-6 grid gap-4 md:grid-cols-2">
                {seasonNotes.map((note) => (
                  <NoteCard
                    href={`/notes/${note.id}`}
                    kicker={note.data.episodeIds.join(" · ")}
                    title={note.data.topic}
                    description={note.data.description}
                    meta={formatDate(note.data.pubDate)}
                    showModes
                  />
                ))}
              </div>
            ) : (
              <p class="mt-6 text-sm text-muted">No notes yet for this season.</p>
            )}

            {season.topics.some((t) => !t.noteId) && (
              <ul class="mt-4 grid gap-2">
                {season.topics
                  .filter((t) => !t.noteId)
                  .map((topic) => (
                    <li class="border border-dashed border-line px-4 py-3">
                      <p class="font-medium">{topic.title}</p>
                      <p class="mt-1 text-sm text-muted">{topic.summary}</p>
                      <p class="mt-2 font-mono text-[11px] text-gold">Note in outline</p>
                    </li>
                  ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </section>
</PageLayout>
