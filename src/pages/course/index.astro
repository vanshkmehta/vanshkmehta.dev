---
import ModeChips from "../../components/ModeChips.astro";
import SeasonCard from "../../components/SeasonCard.astro";
import { seasons } from "../../data/seasons";
import PageLayout from "../../layouts/PageLayout.astro";

const filming = seasons.find((s) => s.status === "filming");
---

<PageLayout
  title="Course"
  description="Sixteen seasons. Whiteboard, interview problems, then a build you can run. Currently filming Season 1: Memory & Low-Level."
>
  <section class="wrap page-head">
    <p class="section-kicker">Curriculum</p>
    <h1 class="display mt-5 max-w-2xl">A CS degree, sequenced the way I wish I got it.</h1>
    <div class="rule-cyan mt-5"></div>
    <p class="lede mt-6">
      Sixteen seasons from bits to machine learning. Each topic is a trilogy: board, then questions, then a small production-shaped build. Notes live on this site; the class is on YouTube.
    </p>
    <ModeChips class="mt-6" />
    {
      filming && (
        <p class="mt-5 font-mono text-xs text-accent">
          Now filming {filming.code} — {filming.title}
        </p>
      )
    }
  </section>

  <section class="wrap pb-16 md:pb-20">
    <ol class="grid min-w-0 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        seasons.map((season) => (
          <li class="min-w-0">
            <SeasonCard season={season} />
          </li>
        ))
      }
    </ol>
  </section>
</PageLayout>
