---
import SeasonCard from "../../components/SeasonCard.astro";
import { seasons } from "../../data/seasons";
import PageLayout from "../../layouts/PageLayout.astro";

const filming = seasons.find((s) => s.status === "filming");
---

<PageLayout
  title="The Roadmap"
  description="16 seasons. One connected journey through Computer Science, from memory and data structures to distributed systems, backend engineering, and machine learning."
>
  <section class="wrap page-head">
    <p class="section-kicker">The Roadmap</p>
    <h1 class="display mt-5 max-w-2xl">16 seasons. One connected journey.</h1>
    <div class="rule-cyan mt-5"></div>
    <p class="lede mt-6">
      Computer Science is not a collection of isolated subjects.
    </p>
    <p class="mt-4 max-w-[40rem] text-[1.02rem] leading-relaxed text-muted">
      A data structure connects to memory. An operating system connects to processes and memory. A network connects to operating systems. A distributed system builds on networks, storage, concurrency, and failure.
    </p>
    <p class="mt-4 max-w-[40rem] text-[1.02rem] leading-relaxed text-muted">
      So the course is structured as a connected path, not a pile of playlists.
    </p>
    {
      filming && (
        <p class="mt-5 font-mono text-xs text-accent">
          Now filming {filming.code}: {filming.title}
        </p>
      )
    }
  </section>

  <section class="wrap pb-16 md:pb-20">
    <ol class="grid min-w-0 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        seasons.map((season) => (
          <li class="min-w-0">
            <SeasonCard season={season} />
          </li>
        ))
      }
    </ol>
  </section>
</PageLayout>
