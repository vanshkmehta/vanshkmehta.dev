---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import { PATHS } from "../../data/site";
import PageLayout from "../../layouts/PageLayout.astro";

const builds = (await getCollection("projects")).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
const single = builds.length === 1;
---

<PageLayout
  title="Builds"
  description="Things I have built: small, runnable projects, with what I decided and what broke."
>
  <section class="wrap page-head">
    <h1 class="display">Builds</h1>
    <p class="lede mt-6">
      Small projects I write to understand something properly. Each one says what I decided and why.
    </p>
  </section>

  <section class="wrap pb-16 md:pb-20">
    {
      single ? (
        <div class="min-w-0">
          {builds.map((build) => (
            <ProjectCard project={build} featured />
          ))}
        </div>
      ) : (
        <div class="grid min-w-0 gap-5 md:grid-cols-2">
          {builds.map((build) => (
            <ProjectCard project={build} />
          ))}
        </div>
      )
    }
  </section>
</PageLayout>
