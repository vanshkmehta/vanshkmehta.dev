---
import { PROFILE } from "../data/profile";
import { PATHS, SITE } from "../data/site";
import { PERSON_ID, breadcrumbLd, faqLd, graph } from "../lib/seo";
import PageLayout from "../layouts/PageLayout.astro";

const ld = graph(
  {
    "@type": "ProfilePage",
    "@id": `${SITE.url}/about#profile`,
    url: `${SITE.url}/about`,
    name: `About ${SITE.name}`,
    mainEntity: { "@id": PERSON_ID },
  },
  breadcrumbLd([
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
  ]),
  faqLd(),
);

const timeline = [
  { when: "2019 to 2023", what: "B.E. in Computer Engineering", where: "PVGCOE, Nashik. CGPA " + PROFILE.education.cgpa },
  { when: "Jan 2023", what: "Built Kavach", where: "A women's safety app. Gold Medal at Anveshana 2023" },
  { when: "Dec 2023 to now", what: "Backend engineer at Jio", where: "Cloud provisioning, in Mumbai" },
  { when: "At Jio", what: "Star Performer, Best Debutant", where: "Jio CloudXP award for quota management" },
  { when: "2026", what: "Building my own products", where: "A sales intelligence tool and TareefKaro" },
  { when: "2026", what: "Making videos on YouTube", where: "youtube.com/@vanshkmehta" },
] as const;

const stack = [
  { label: "Languages", value: "Java (mostly), SQL" },
  { label: "Backend", value: "Spring Boot, Spring MVC, Spring Data JPA, Spring AI, Hibernate" },
  { label: "Data", value: "PostgreSQL, Oracle, Redis" },
  { label: "Messaging", value: "RabbitMQ, event-driven design" },
  { label: "Infrastructure", value: "Docker, Kubernetes (CKAD), Linux, Maven, Git" },
  { label: "AI", value: "Claude API, Spring AI" },
] as const;
---

<PageLayout
  title="About"
  description="Vansh Mehta is a backend engineer at Jio in Mumbai who builds cloud provisioning systems for 100K+ enterprise users, won a Gold Medal at Anveshana 2023, and makes videos about how software works."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <section class="wrap page-head">
    <h1 class="display max-w-3xl">I build backend systems, then explain how they work.</h1>
  </section>

  <section class="wrap grid min-w-0 gap-12 pb-16 md:pb-24 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
    <div class="min-w-0 max-w-[46rem] space-y-6 text-[1.02rem] leading-relaxed text-muted">
      <p class="text-lg text-ink">
        I'm Vansh, a backend engineer at Jio in Mumbai. I work on the cloud platform that gives enterprise customers their servers, storage and networks, and I make sure those orders go through.
      </p>

      <h2 class="title pt-6 text-ink">What I build at Jio</h2>
      <p>
        When a customer orders a VM or a disk, a lot can go wrong between the click and the running machine. My work is making that path hold up, for 100K+ enterprise users.
      </p>
      <ul class="list-disc space-y-2 pl-5">
        <li>An async quota validation framework that works across ROS, HCI, GCP and Jio's own infrastructure.</li>
        <li>A central quota engine for VMs, block storage, security groups and HSM orders. Failed orders after provisioning dropped 40%.</li>
        <li>A capacity check that looks at both logical and physical limits, which ended over-commit failures.</li>
        <li>A RabbitMQ order pipeline so provisioning steps don't block each other.</li>
        <li>An ops logging and diagnostics framework. Closing a production incident now takes 60% less time.</li>
        <li>A scheduled PostgreSQL to Oracle sync job, and a large part of the disaster recovery replication workflows.</li>
      </ul>

      <h2 class="title pt-6 text-ink">Star Performer, Best Debutant</h2>
      <p>
        Jio CloudXP gave me its Star Performer, Best Debutant award for my work on Resource-Based Quota Management: ownership, technical depth and reliable delivery. It meant a lot, coming early in my journey.
      </p>
      <figure class="not-prose">
        <img
          src={PROFILE.awards[0].image800}
          srcset={`${PROFILE.awards[0].image800} 800w, ${PROFILE.awards[0].image} 1600w`}
          sizes="(min-width: 1024px) 46rem, 100vw"
          width="800"
          height="582"
          loading="lazy"
          alt="Jio CloudXP certificate: Star Performer, Best Debutant, awarded to Vanshit Mehta for Resource-Based Quota Management."
          class="w-full border border-line"
        />
      </figure>

      <h2 class="title pt-6 text-ink">Kavach</h2>
      <p>
        In January 2023 I built Kavach, an Android app for women's safety. One tap sends an SOS with your live location, and an admin portal shows responders where to go. It won the Gold Medal at Anveshana 2023 and was shortlisted for the Government of India Tech Innovation Awards. It's the project that made me want to build things people actually use.
      </p>

      <h2 class="title pt-6 text-ink">Why the videos</h2>
      <p>
        I learn best by building something and then explaining it to someone else, so I started doing that in public. Databases first, then low-level design, system design and distributed systems.
        <a class="text-accent hover:underline" href={PATHS.course}>Here's the plan</a>.
      </p>

      <h2 class="title pt-6 text-ink">What I work with</h2>
      <dl class="grid gap-3 sm:grid-cols-[9rem_minmax(0,1fr)]">
        {
          stack.map((row) => (
            <>
              <dt class="caption text-faint">{row.label}</dt>
              <dd class="text-ink">{row.value}</dd>
            </>
          ))
        }
      </dl>
      <p>I also hold the {PROFILE.certification} certification.</p>

      <h2 class="title pt-6 text-ink">Quick answers</h2>
      <div class="divide-y divide-line border-y border-line">
        {
          PROFILE.faq.map((f) => (
            <details class="py-4">
              <summary class="cursor-pointer font-medium text-ink">{f.q}</summary>
              <p class="mt-2">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>

    <aside class="min-w-0 space-y-8 lg:sticky lg:top-24 lg:self-start" aria-label="Photo, timeline and contact">
      <img src="/vansh.webp" width="320" height="320" alt="Vansh Mehta" class="aspect-square w-48 border-2 border-ink object-cover lg:w-full" loading="eager" />
      <div>
        <p class="caption text-accent">Timeline</p>
        <ol class="mt-4 space-y-5 border-l-2 border-ink pl-5">
          {
            timeline.map((t) => (
              <li class="min-w-0">
                <p class="caption text-faint">{t.when}</p>
                <p class="mt-1 text-sm font-medium text-ink">{t.what}</p>
                <p class="text-sm text-muted">{t.where}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <p class="caption text-accent">Find me</p>
        <p class="mt-3 flex flex-col gap-2 text-sm">
          <a class="text-ink hover:text-accent" href={SITE.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
          <a class="text-ink hover:text-accent" href={SITE.x} target="_blank" rel="noopener noreferrer">X</a>
          <a class="text-ink hover:text-accent" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="text-ink hover:text-accent" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="break-all text-ink hover:text-accent" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a class="text-ink hover:text-accent" href="/resume.pdf">Resume (PDF)</a>
        </p>
      </div>
    </aside>
  </section>
</PageLayout>
