---
import { SITE } from "../data/site";
import { canonical } from "../lib/utils";
import { graph, personLd, websiteLd } from "../lib/seo";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  pubDate?: Date;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogType = "website",
  pubDate,
  noindex = false,
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} · ${SITE.name}`;
const canonicalUrl = canonical(Astro.url.pathname, SITE.url);
const ogImage = new URL("/og.png", SITE.url).href;
const ogAlt = "Vansh Mehta, backend engineer at Jio. Systems for 100K+ enterprise users.";
const siteLd = graph(personLd(), websiteLd());
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var light = stored !== "dark";
          document.documentElement.classList.toggle("light", light);
          document.documentElement.style.colorScheme = light ? "light" : "dark";
        } catch {
          /* localStorage can be unavailable; CSS default is dark navy */
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="me" href={SITE.github} />
    <link rel="me" href={SITE.linkedin} />
    <link rel="me" href={SITE.youtube} />
    <link rel="me" href={SITE.x} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable summary" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} notes`} href={new URL(SITE.rss, SITE.url).href} />
    <meta name="theme-color" content="#ECEBE6" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-canvas text-ink antialiased">
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
  </body>
</html>
