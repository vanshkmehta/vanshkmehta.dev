---
import { SITE } from "../data/site";

const host = SITE.url.replace("https://", "");
const socials = [
  { href: SITE.youtube, label: "YouTube" },
  { href: SITE.github, label: "GitHub" },
  { href: SITE.linkedin, label: "LinkedIn" },
] as const;
---

<footer class="border-t border-line">
  <div class="wrap py-12 md:py-14">
    <p class="font-mono text-sm text-accent">$ cd {host}</p>
    <p class="mt-3 font-mono text-xs tracking-wide text-muted">
      learn → understand → build → repeat
    </p>

    <p class="mt-8 text-ink">{SITE.name}</p>
    <p class="mt-1 text-sm text-muted">
      {SITE.role} at Jio · {SITE.educatorRole}
    </p>

    <p class="mt-4 font-mono text-xs text-muted">
      {
        socials.map((link, index) => (
          <>
            {index > 0 && <span class="text-faint"> · </span>}
            <a
              class="text-muted hover:text-accent"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
            </a>
          </>
        ))
      }
    </p>

    <p class="mt-8 font-mono text-[11px] tracking-wide text-faint">
      © 2026 {SITE.name} · {SITE.location}
    </p>
    <p class="mt-2 text-sm text-muted">What happens next is up to you.</p>
  </div>
</footer>
