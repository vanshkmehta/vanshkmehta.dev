---
import { SITE } from "../data/site";

const socials = [
  { href: SITE.youtube, label: "YouTube" },
  { href: SITE.x, label: "X" },
  { href: SITE.github, label: "GitHub" },
  { href: SITE.linkedin, label: "LinkedIn" },
] as const;
---

<footer class="border-t border-line">
  <div class="wrap flex min-w-0 flex-col gap-6 py-10 md:flex-row md:items-end md:justify-between">
    <div class="min-w-0">
      <p class="text-ink">{SITE.name}</p>
      <p class="mt-1 text-sm text-muted">Backend engineer at Jio, {SITE.location}</p>
      <a class="mt-3 block break-all font-mono text-xs text-muted hover:text-accent" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
    <div class="min-w-0">
      <p class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs">
        {
          socials.map((link) => (
            <a class="text-muted hover:text-accent" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
          ))
        }
      </p>
      <p class="mt-4 font-mono text-[11px] text-faint">© 2026 {SITE.name}</p>
    </div>
  </div>
</footer>
