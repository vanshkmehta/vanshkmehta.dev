---
import type { CollectionEntry } from "astro:content";
import PermissionDiagram from "./diagrams/PermissionDiagram.astro";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const href = `/projects/${project.id}`;

const kindLabel =
  project.data.kind === "engine" ? "Engine" : project.data.kind === "cli" ? "CLI" : "SaaS";
---

<a
  href={href}
  class:list={[
    "card card-hover group grid min-w-0 no-underline",
    featured ? "lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]" : "h-full grid-rows-[auto_1fr]",
  ]}
>
  <div
    class:list={[
      "diagram-frame border-b border-line bg-[var(--canvas)] p-4 sm:p-5",
      featured && "lg:border-r lg:border-b-0",
    ]}
  >
    <PermissionDiagram />
  </div>
  <div class="flex min-w-0 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2">
      <p class="caption text-accent">{kindLabel}</p>
      {
        project.data.status === "in-development" && (
          <span class="mode-chip mode-chip-questions">In development</span>
        )
      }
    </div>
    <h3 class:list={["title mt-3 line-clamp-2 text-ink", featured && "md:text-2xl md:leading-snug"]}>
      {project.data.title}
    </h3>
    <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{project.data.description}</p>
    {
      project.data.interfaceNote && (
        <p class="mt-3 truncate font-mono text-[11px] text-faint">{project.data.interfaceNote}</p>
      )
    }
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {
        project.data.stack.slice(0, featured ? 8 : 4).map((item) => (
          <li class="border border-line px-2 py-0.5 font-mono text-[10px] tracking-wide text-muted uppercase">
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</a>
