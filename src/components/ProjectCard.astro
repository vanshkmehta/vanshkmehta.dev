---
import type { CollectionEntry } from "astro:content";
import PermissionDiagram from "./diagrams/PermissionDiagram.astro";
import HexDiagram from "./diagrams/HexDiagram.astro";
import PipelineDiagram from "./diagrams/PipelineDiagram.astro";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const href = `/projects/${project.id}`;
---

<a
  href={href}
  class:list={[
    "card-hover group grid no-underline border border-line bg-canvas-elevated",
    featured ? "gap-0 lg:grid-cols-[1.1fr_0.9fr]" : "h-full grid-rows-[auto_1fr]",
  ]}
>
  <div class:list={["border-b border-line bg-[var(--canvas)] p-4 sm:p-5", featured && "lg:border-b-0 lg:border-r"]}>
    {
      project.data.kind === "engine" && <PermissionDiagram />
    }
    {
      project.data.kind === "cli" && <HexDiagram />
    }
    {
      project.data.kind === "saas" && <PipelineDiagram />
    }
  </div>
  <div class="flex flex-col p-5 sm:p-6">
    <div class="flex flex-wrap items-center gap-2">
      <p class="font-mono text-[11px] tracking-widest text-accent uppercase">
        {project.data.kind === "engine" ? "Engine" : project.data.kind === "cli" ? "CLI" : "SaaS"}
      </p>
      {
        project.data.status === "in-development" && (
          <span class="mode-chip mode-chip-questions">In development</span>
        )
      }
    </div>
    <h3 class:list={["mt-2 font-medium tracking-tight text-ink", featured ? "text-2xl" : "text-lg"]}>
      {project.data.title}
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{project.data.description}</p>
    {
      project.data.interfaceNote && (
        <p class="mt-3 font-mono text-[11px] text-faint">{project.data.interfaceNote}</p>
      )
    }
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {
        project.data.stack.slice(0, featured ? 8 : 4).map((item) => (
          <li class="border border-line px-2 py-0.5 font-mono text-[10px] tracking-wide text-muted uppercase">
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</a>
