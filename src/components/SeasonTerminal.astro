---
const lines = [
  { code: "S1", title: "Memory & Low-Level", state: "filming" },
  { code: "S2", title: "Data Structures I", state: "queued" },
  { code: "S8", title: "Operating Systems", state: "queued" },
  { code: "S12", title: "Distributed Systems", state: "queued" },
  { code: "S16", title: "Machine Learning", state: "queued" },
];
---

<div class="card min-w-0 overflow-hidden font-mono text-[12px] leading-6 text-muted">
  <div class="flex items-center gap-2 border-b border-line px-3 py-2 text-[11px]">
    <span class="size-2 shrink-0 rounded-full bg-faint/70"></span>
    <span class="size-2 shrink-0 rounded-full bg-muted/70"></span>
    <span class="size-2 shrink-0 rounded-full bg-accent"></span>
    <span class="ml-2 truncate text-faint">seasons</span>
  </div>
  <div class="min-w-0 px-4 py-4">
    <p class="truncate text-faint">$ course ls --seasons</p>
    <ul class="mt-3 space-y-1">
      {
        lines.map((line) => (
          <li class="grid min-w-0 grid-cols-[2.25rem_minmax(0,1fr)_auto] gap-2">
            <span class="text-accent">{line.code}</span>
            <span class="truncate text-ink">{line.title}</span>
            <span class:list={["shrink-0", line.state === "filming" ? "text-gold" : "text-faint"]}>{line.state}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-faint">16 seasons · one connected journey</p>
    <p class="text-accent">_</p>
  </div>
</div>
