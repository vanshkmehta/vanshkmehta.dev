---
const lines = [
  { code: "S1", title: "Memory & Low-Level", state: "filming" },
  { code: "S2", title: "Data Structures I", state: "queued" },
  { code: "S8", title: "Operating Systems", state: "queued" },
  { code: "S12", title: "Distributed Systems", state: "queued" },
  { code: "S16", title: "Machine Learning", state: "queued" },
];
---

<div class="border border-line bg-canvas-elevated font-mono text-[12px] leading-6 text-muted shadow-[0_20px_50px_rgb(0_0_0_/0.08)]">
  <div class="flex items-center gap-2 border-b border-line px-3 py-2 text-[11px]">
    <span class="size-2 rounded-full bg-faint/70"></span>
    <span class="size-2 rounded-full bg-muted/70"></span>
    <span class="size-2 rounded-full bg-accent"></span>
    <span class="ml-2 text-faint">seasons — list</span>
  </div>
  <div class="px-4 py-4">
    <p class="text-faint">$ course ls --seasons</p>
    <ul class="mt-3 space-y-1">
      {
        lines.map((line) => (
          <li class="grid grid-cols-[2.4rem_1fr_auto] gap-3">
            <span class="text-accent">{line.code}</span>
            <span class="truncate text-ink">{line.title}</span>
            <span class:list={[line.state === "filming" ? "text-gold" : "text-faint"]}>{line.state}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-faint">16 seasons · whiteboard → questions → build</p>
    <p class="text-accent">_</p>
  </div>
</div>
