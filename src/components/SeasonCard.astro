---
import type { Season } from "../data/seasons";
import { countEpisodes, liveEpisodes } from "../data/seasons";

interface Props {
  season: Season;
}

const { season } = Astro.props;
const href = season.id === 1 ? `/course/${season.slug}` : undefined;
const topicCount = season.topics.length;
const episodeCount = countEpisodes(season);
const liveIds = season.topics.flatMap((topic) => liveEpisodes(topic).map((episode) => episode.id));
const liveLabel =
  liveIds.length === 1 ? `${liveIds[0]} live` : liveIds.length > 1 ? `${liveIds.length} live` : "season page";
const counts = `${topicCount} ${topicCount === 1 ? "topic" : "topics"} · ${episodeCount} ${episodeCount === 1 ? "episode" : "episodes"}`;
---

{
  href ? (
    <a href={href} class="card card-hover flex h-full flex-col p-6 no-underline">
      <div class="flex items-center justify-between gap-3">
        <p class="font-mono text-xs text-accent">{season.code}</p>
        <span class="caption text-accent">Filming</span>
      </div>
      <h3 class="title mt-4 line-clamp-2 text-ink">{season.title}</h3>
      <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{season.pitch}</p>
      <p class="mt-5 font-mono text-[11px] text-faint">
        {counts} · {liveLabel}
      </p>
    </a>
  ) : (
    <article class="card flex h-full flex-col p-6 opacity-90">
      <div class="flex items-center justify-between gap-3">
        <p class="font-mono text-xs text-faint">{season.code}</p>
        <span class="caption text-faint">Queued</span>
      </div>
      <h3 class="title mt-4 line-clamp-2 text-ink">{season.title}</h3>
      <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{season.pitch}</p>
      <p class="mt-5 font-mono text-[11px] text-faint">{counts}</p>
    </article>
  )
}
