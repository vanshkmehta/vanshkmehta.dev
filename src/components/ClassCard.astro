---
import type { LiveEpisode, Season } from "../data/seasons";
import { youtubeThumbUrl, youtubeWatchUrl } from "../data/seasons";

interface Props {
  episode: LiveEpisode;
  season: Season;
  eager?: boolean;
}

const { episode, season, eager = false } = Astro.props;
const href = youtubeWatchUrl(episode.youtubeId);
const thumb = youtubeThumbUrl(episode.youtubeId);
const alt = episode.subtitle
  ? `${episode.title}: ${episode.subtitle}`
  : episode.title;
---

<a
  href={href}
  class="card card-hover grid min-w-0 no-underline lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]"
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="relative min-w-0 overflow-hidden border-b border-line bg-[var(--canvas)] lg:border-r lg:border-b-0">
    <img
      src={thumb}
      alt={alt}
      width="1280"
      height="720"
      class="aspect-video size-full object-cover"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
    <span class="pointer-events-none absolute inset-0 grid place-items-center bg-[#101b31]/35">
      <span class="grid size-12 place-items-center rounded-full bg-accent text-accent-fg" aria-hidden="true">
        <svg class="ml-0.5 size-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5.14v13.72L19.5 12 8 5.14z"></path>
        </svg>
      </span>
    </span>
  </div>
  <div class="min-w-0 p-6 sm:p-8">
    <p class="caption text-accent">Latest class · {episode.id}</p>
    <p class="mt-3 font-mono text-sm text-ink">{season.code} · {season.title}</p>
    <h3 class="title mt-3 text-ink">{episode.title}</h3>
    {
      episode.subtitle && (
        <p class="mt-2 text-sm leading-relaxed text-ink">{episode.subtitle}</p>
      )
    }
    <p class="mt-3 text-sm leading-relaxed text-muted">{episode.blurb}</p>
    <p class="mt-6 font-mono text-xs text-accent">Watch on YouTube →</p>
  </div>
</a>
