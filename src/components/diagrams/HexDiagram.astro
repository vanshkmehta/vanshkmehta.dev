<svg viewBox="0 0 520 260" class="h-auto w-full text-ink" role="img" aria-label="Hex inspector CLI showing a byte, its binary, and a nibble decode.">
  <rect x="1" y="1" width="518" height="258" fill="var(--canvas-elevated)" stroke="currentColor" stroke-opacity="0.12" />
  <text x="20" y="28" fill="currentColor" fill-opacity="0.45" font-family="JetBrains Mono, ui-monospace, monospace" font-size="11">$ hexinspect 0x4B</text>
