---
import ModeChips from "./ModeChips.astro";

interface Props {
  href: string;
  kicker: string;
  title: string;
  description: string;
  meta?: string;
  pending?: boolean;
  showModes?: boolean;
}

const { href, kicker, title, description, meta, pending = false, showModes = false } = Astro.props;
---

{
  pending ? (
    <article class="card flex h-full flex-col border-dashed p-6">
      <p class="caption truncate text-faint">{kicker}</p>
      <h3 class="title mt-3 line-clamp-2">{title}</h3>
      <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{description}</p>
      {showModes && <ModeChips class="mt-5" />}
      {meta && <p class="mt-4 font-mono text-[11px] text-gold">{meta}</p>}
    </article>
  ) : (
    <a href={href} class="card card-hover flex h-full flex-col p-6 no-underline">
      <p class="caption truncate text-accent">{kicker}</p>
      <h3 class="title mt-3 line-clamp-2 text-ink">{title}</h3>
      <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{description}</p>
      {showModes && <ModeChips class="mt-5" />}
      {meta && <p class="mt-4 font-mono text-[11px] text-faint">{meta}</p>}
    </a>
  )
}
