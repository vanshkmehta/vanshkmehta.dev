---
import { SITE } from "../data/site";

interface Props {
  class?: string;
  compact?: boolean;
}

const { class: className = "", compact = false } = Astro.props;

const links = [
  {
    href: SITE.youtube,
    label: "YouTube",
    icon: "youtube",
  },
  {
    href: SITE.github,
    label: "GitHub",
    icon: "github",
  },
  {
    href: SITE.linkedin,
    label: "LinkedIn",
    icon: "linkedin",
  },
] as const;
---

<ul class:list={["flex min-w-0 flex-wrap items-center gap-1", className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={[
            "inline-flex shrink-0 items-center text-muted transition-colors hover:text-ink hover:border-accent",
            compact ? "size-9 justify-center border border-transparent hover:border-line" : "gap-2 border border-line px-2.5 py-1.5 text-xs",
          ]}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${link.label} (opens in a new tab)`}
        >
          {link.icon === "youtube" && (
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.5 6.2a3 3 0 0 0-2.1-2.2C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 32 32 0 0 0 0 12a32 32 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.2c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.2A32 32 0 0 0 24 12a32 32 0 0 0-.5-5.8zM9.8 15.5v-7l6.3 3.5-6.3 3.5z" />
            </svg>
          )}
          {link.icon === "github" && (
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5A11.5 11.5 0 0 0 .5 12.3c0 5.2 3.4 9.6 8.1 11.2.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.5-1.3-1.2-1.7-1.2-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 .1.8 1.7 2.7 1.2.1-.8.4-1.3.7-1.6-2.6-.3-5.4-1.3-5.4-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.3 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 3 .1 3.3.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.4 6 .4.3.8 1 .8 2.1v3.1c0 .3.2.7.8.6A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z" />
            </svg>
          )}
          {link.icon === "linkedin" && (
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6v6.3h-4v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21H9z" />
            </svg>
          )}
          {!compact && <span class="font-mono tracking-wide">{link.label}</span>}
        </a>
      </li>
    ))
  }
</ul>
